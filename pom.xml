<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project Information -->
    <groupId>com.web.mvc.apps</groupId>

    <artifactId>SpringFormApp</artifactId>

    <version>1.0.0</version>

    <packaging>war</packaging>

    <name>SpringMVCFormApp</name>

    <url>http://maven.apache.org</url>


    <!-- Dependencies -->
    <dependencies>

        <!-- JUnit -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>


        <!-- Spring MVC -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>4.3.6.RELEASE</version>
        </dependency>


        <!-- Servlet API -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.0.1</version>
            <scope>provided</scope>
        </dependency>


        <!-- JSP API -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.1</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>


    <!-- WAR Build Configuration -->
    <build>

        <finalName>SpringFormApp</finalName>

    </build>


    <!-- JFrog Maven Repository -->
    <distributionManagement>

        <repository>

            <id>jfrog</id>

            <url>
                https://trial57pdoi.jfrog.io/artifactory/springmvc-war-maven-local
            </url>

        </repository>

    </distributionManagement>


</project>
